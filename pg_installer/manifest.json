{
  "module": "pg_installer",
  "version": "1.0",
  "description": "PostgreSQL 설치 스크립트 (single / HA)",
  "entry": "postgresql_install.sh",
  "requires": {
    "rpm": [
      "gcc",
      "make",
      "bison",
      "flex",
      "readline-devel",
      "zlib-devel",
      "openssl-devel",
      "libicu-devel",
      "systemd-devel",
      "python3-devel",
      "tcl-devel",
      "perl-devel",
      "perl-ExtUtils-Embed",
      "perl-core",
      "libxml2-devel",
      "libxslt-devel",
      "pkgconf-pkg-config",
      "ncurses-devel",
      "lz4-devel",
      "libzstd-devel",
      "libuuid-devel",
      "wget",
      "tar",
      "gzip",
      "bzip2",
      "bc",
      "glibc-langpack-ko",
      "gettext",
      "glibc-langpack-en"
    ],
    "rpm_by_major": {
      "_comment": "PG 메이저 버전 이상일 때 추가로 받는 rpm (키 = 최소 메이저). 저장소에 없으면 건너뜀",
      "18": [
        "liburing-devel"
      ]
    }
  }
}
